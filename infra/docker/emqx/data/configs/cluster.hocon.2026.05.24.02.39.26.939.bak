# This file is generated. Do not edit.
# The configs are results of online config changes from UI/API/CLI.
# To persist configs in this file, copy the content to etc/base.hocon.
authentication = [
  {
    backend = postgresql
    database = postgres
    disable_prepared_statements = false
    enable = true
    mechanism = password_based
    password = CHANGE_ME_STRONG_PASSWORD
    password_hash_algorithm {name = sha256, salt_position = suffix}
    pool_size = 8
    query = """~
      SELECT
        password_hash,
        salt
      FROM eqp.mqtt_user
      WHERE username = ${username}
      LIMIT 1~"""
    server = "host.docker.internal:54322"
    ssl {
      ciphers = []
      depth = 10
      enable = false
      hibernate_after = "5s"
      log_level = notice
      reuse_sessions = true
      secure_renegotiate = true
      verify = verify_peer
      versions = [
        "tlsv1.3",
        "tlsv1.2"
      ]
    }
    username = emqx_user
  }
]
authorization {
  cache {
    enable = true
    excludes = []
    max_size = 32
    ttl = "1m"
  }
  deny_action = ignore
  no_match = allow
  sources = [
    {
      database = postgres
      disable_prepared_statements = false
      enable = true
      password = CHANGE_ME_STRONG_PASSWORD
      pool_size = 8
      query = """~
        SELECT permission, action, topic
        FROM epq.mqtt_acl
        WHERE username = ${username}
        ORDER BY id ASC~"""
      server = "host.docker.internal:54322"
      ssl {
        ciphers = []
        depth = 10
        enable = false
        hibernate_after = "5s"
        log_level = notice
        reuse_sessions = true
        secure_renegotiate = true
        verify = verify_peer
        versions = [
          "tlsv1.3",
          "tlsv1.2"
        ]
      }
      type = postgresql
      username = emqx_user
    }
  ]
}
log {
  console {}
  file {}
}
